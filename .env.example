# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HUGGING_FACE: Optional alternative for actual high-fidelity AI Image Generation
# If you don't have a paid Gemini plan, you can use your Hugging Face API token for free!
# Create a free token at https://huggingface.co/settings/tokens
HF_API_KEY=""
# Optional model name. Defaults to black-forest-labs/FLUX.1-schnell (superb & fast)
HF_MODEL="black-forest-labs/FLUX.1-schnell"

# MAGIC_HOUR: Paid API key from magichour.ai for image generation & image editing
MAGIC_HOUR_API_KEY=""

# AGNES: API key from agnes-ai.com for image generation & image editing
AGNES_API_KEY=""

# YELP: Yelp Fusion API key for accurate, live local businesses and reviews
YELP_API_KEY=""

