{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "description": "User role (e.g., Caregiver)" },
        "ageGroup": { "type": "string", "description": "Target age group" },
        "notificationsEnabled": { "type": "boolean", "description": "Notification preference" },
        "privacyLevel": { "type": "string", "description": "Privacy setting" }
      },
      "required": ["name", "email"]
    },
    "Home": {
      "title": "Home",
      "description": "A residential property being monitored",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Home name" },
        "address": { "type": "string", "description": "Physical address" },
        "type": { "type": "string", "description": "Property type" },
        "lastScan": { "type": "string", "description": "ISO timestamp of last scan" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "rooms": { "type": "array", "description": "List of room IDs or names" }
      },
      "required": ["userId", "name", "createdAt", "updatedAt"]
    },
    "Scan": {
      "title": "Safety Scan",
      "description": "A safety analysis of a room",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User who performed the scan" },
        "roomId": { "type": "string", "description": "Room ID" },
        "homeId": { "type": "string", "description": "Home ID" },
        "images": { "type": "array", "description": "List of image URLs" },
        "status": { "type": "string", "description": "Scan status" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "safetyScore": { "type": "number", "description": "Safety score out of 100" },
        "hazards": { "type": "array", "description": "List of detected hazards" },
        "recommendations": { "type": "array", "description": "List of safety recommendations" }
      },
      "required": ["userId", "roomId", "homeId", "status", "createdAt"]
    },
    "Activity": {
      "title": "Activity Log",
      "description": "A log entry for user activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID" },
        "homeId": { "type": "string", "description": "Home ID" },
        "action": { "type": "string", "description": "Action performed" },
        "description": { "type": "string", "description": "Description of action" },
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "TimelineEvent": {
      "title": "Timeline Event",
      "description": "An event displayed in the activity timeline",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID" },
        "homeId": { "type": "string", "description": "Home ID" },
        "type": { "type": "string", "description": "Event type" },
        "title": { "type": "string", "description": "Event title" },
        "description": { "type": "string", "description": "Event description" },
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["userId", "type", "title", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A user notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID" },
        "type": { "type": "string", "description": "Notification type" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification message" },
        "isRead": { "type": "boolean", "description": "Read status" },
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["userId", "type", "title", "timestamp", "isRead"]
    },
    "StagedPhoto": {
      "title": "Staged Room Photo",
      "description": "A room photograph staged from mobile or desktop awaiting AI safety assessment",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID" },
        "homeId": { "type": "string", "description": "Home ID" },
        "roomId": { "type": "string", "description": "Room ID" },
        "roomType": { "type": "string", "description": "Room category type" },
        "title": { "type": "string", "description": "Photo label or title" },
        "notes": { "type": "string", "description": "Observation notes" },
        "imageUrl": { "type": "string", "description": "Image data URL or hosted link" },
        "status": { "type": "string", "description": "Processing status" },
        "capturedFrom": { "type": "string", "description": "Source device type" },
        "createdAt": { "type": "string", "description": "ISO timestamp of upload" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of update" }
      },
      "required": ["userId", "homeId", "roomType", "title", "imageUrl", "status", "createdAt"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": { "schema": "Profile", "description": "User profiles" },
    "/homes/{homeId}": { "schema": "Home", "description": "Home definitions" },
    "/scans/{scanId}": { "schema": "Scan", "description": "Safety scans" },
    "/activities/{activityId}": { "schema": "Activity", "description": "Activity logs" },
    "/timelineEvents/{eventId}": { "schema": "TimelineEvent", "description": "Timeline events" },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "User notifications" },
    "/stagedPhotos/{photoId}": { "schema": "StagedPhoto", "description": "Staged room photos awaiting safety analysis" }
  }
}

